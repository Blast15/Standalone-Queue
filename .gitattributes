# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted to native line endings on checkout
*.java text diff=java
*.yml text
*.yaml text
*.md text
*.xml text
*.gradle.kts text
*.properties text

# Windows script files must have CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.ico binary
